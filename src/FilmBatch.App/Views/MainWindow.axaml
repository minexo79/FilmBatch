<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FilmBatch.App.ViewModels"
        xmlns:v="using:FilmBatch.App.Views"
        xmlns:l="using:FilmBatch.App.Localization"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="FilmBatch.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="1280" MinHeight="800" Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        Icon="avares://FilmBatch/Assets/icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">
  <!-- 主視窗（計畫書 2.3）：頂列（選單）｜Dock（中預覽、右側邊欄＋常用動作、下縮圖列）｜底列（檢視控制與狀態） -->
  <DockPanel>
    <!-- ───── 頂列：圖示｜選單｜標題（拖曳區）｜系統按鈕保留區 ───── -->
    <Grid DockPanel.Dock="Top" Name="TitleBar" Classes="topbar" ColumnDefinitions="Auto,Auto,*,Auto"
          IsVisible="{Binding !IsFullScreen}">
      <Image Grid.Column="0" Name="TitleIcon" Source="avares://FilmBatch/Assets/icon.ico" Width="18" Height="18" Margin="14,0,6,0"
             VerticalAlignment="Center" IsHitTestVisible="False" />
      <!-- 空白處為原生標題列拖曳區（拖曳移動、雙擊最大化、Windows 貼齊版面） -->
      <Border Grid.Column="2" Name="TitleDragArea" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
        <TextBlock Text="{Binding WindowTitle}" Classes="secondary" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="16,0" IsHitTestVisible="False" />
      </Border>

      <!-- 系統的最小化／最大化／關閉按鈕所在位置（由程式依平台設定寬度） -->
      <Border Grid.Column="3" Name="CaptionButtonsSpace" Width="138" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />
    <Menu Grid.Column="1" Name="MainMenu" VerticalAlignment="Center" Background="Transparent">
      <MenuItem Header="{l:Tr Menu.File}">
        <MenuItem Header="{l:Tr Cmd.OpenFolder}" Command="{Binding OpenFolderCommand}" InputGesture="{OnPlatform Ctrl+O, macOS=Meta+O}" />
        <MenuItem Header="{l:Tr Cmd.OpenSamples}" Command="{Binding OpenSamplesCommand}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.Export}" Command="{Binding ExportCommand}" InputGesture="{OnPlatform Ctrl+E, macOS=Meta+E}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.Preferences}" Command="{Binding PreferencesCommand}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.Exit}" Name="ExitItem" />
      </MenuItem>
      <MenuItem Header="{l:Tr Menu.Edit}">
        <MenuItem Header="{l:Tr Cmd.Undo}" Command="{Binding UndoCommand}" InputGesture="{OnPlatform Ctrl+Z, macOS=Meta+Z}" />
        <MenuItem Header="{l:Tr Cmd.Redo}" Command="{Binding RedoCommand}" InputGesture="{OnPlatform Ctrl+Shift+Z, macOS=Meta+Shift+Z}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.Copy}" Command="{Binding CopyCommand}" InputGesture="{OnPlatform Ctrl+C, macOS=Meta+C}" />
        <MenuItem Header="{l:Tr Cmd.Paste}" Command="{Binding PasteCommand}" InputGesture="{OnPlatform Ctrl+V, macOS=Meta+V}" />
        <MenuItem Header="{l:Tr Cmd.PastePresetOnly}" Command="{Binding PastePresetOnlyCommand}" />
        <MenuItem Header="{l:Tr Cmd.PasteSpecial}" Command="{Binding PasteSpecialCommand}" InputGesture="{OnPlatform Ctrl+Shift+V, macOS=Meta+Shift+V}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.SelectAll}" Command="{Binding SelectAllCommand}" InputGesture="{OnPlatform Ctrl+A, macOS=Meta+A}" />
      </MenuItem>
      <MenuItem Header="{l:Tr Menu.View}">
        <MenuItem Header="{l:Tr Cmd.SplitCompare}" Command="{Binding ToggleSplitCommand}" InputGesture="Y" />
        <MenuItem Header="{l:Tr Cmd.Crop}" Command="{Binding ToggleCropCommand}" InputGesture="R" />
        <MenuItem Header="{l:Tr Cmd.ZoomFit}" Command="{Binding ZoomFitCommand}" InputGesture="{OnPlatform Ctrl+D0, macOS=Meta+D0}" />
        <MenuItem Header="{l:Tr Cmd.Zoom100}" Command="{Binding Zoom100Command}" InputGesture="{OnPlatform Ctrl+D1, macOS=Meta+D1}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.TogglePanels}" Command="{Binding TogglePanelsCommand}" InputGesture="Tab" />
        <MenuItem Header="{l:Tr Cmd.FullScreen}" Command="{Binding ToggleFullScreenCommand}" InputGesture="F" />
        <MenuItem Header="{l:Tr Cmd.ResetLayout}" Command="{Binding ResetLayoutCommand}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.Gallery}" Command="{Binding ShowGalleryCommand}" />
      </MenuItem>
      <MenuItem Header="{l:Tr Menu.Presets}">
        <MenuItem Header="{l:Tr Cmd.CreatePreset}" Command="{Binding CreatePresetCommand}" />
        <MenuItem Header="{l:Tr Cmd.ManagePresets}" Command="{Binding ManagePresetsCommand}" />
      </MenuItem>
      <MenuItem Header="{l:Tr Menu.Help}">
        <MenuItem Header="{l:Tr Cmd.OpenGitHub}" Command="{Binding OpenGitHubCommand}" />
        <MenuItem Header="{l:Tr Cmd.ReportIssue}" Command="{Binding ReportIssueCommand}" />
        <Separator />
        <MenuItem Header="{l:Tr Cmd.About}" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>
    </Grid>

    <!-- ───── 底列：左｜算圖狀態與 GPU；右｜選取數量與背景工作（檢視控制移至預覽區下方中央） ───── -->
    <Grid DockPanel.Dock="Bottom" Classes="bottombar" ColumnDefinitions="*,*" IsVisible="{Binding !IsFullScreen}">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" Margin="14,0" VerticalAlignment="Center">
        <TextBlock Classes="numeric" Text="{Binding LastRenderText}" ToolTip.Tip="{l:Tr Tip.LastRender}" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource Icon.Warning}" Width="11" Height="11" Foreground="{DynamicResource FB.WarningTextBrush}" IsVisible="{Binding IsSoftwareGpu}" />
          <TextBlock Text="{Binding GpuName}" Classes.warning="{Binding IsSoftwareGpu}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="14,0" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="{Binding SelectionText}" />
        <Button Classes="icon" Padding="6,2" Background="Transparent">
          <TextBlock Text="{Binding BackgroundText}" />
          <Button.Flyout>
            <Flyout>
              <StackPanel Width="260" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{l:Tr Status.BackgroundTasks}" />
                <TextBlock Classes="small" Text="{Binding BackgroundText}" />
                <TextBlock Classes="small" Text="{Binding Sidebar.Export.StatusText}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ───── 主區域 ───── -->
    <Panel>
      <dock:DockControl Name="DockHost" InitializeLayout="False" InitializeFactory="True" IsVisible="{Binding !PanelsHidden}">
        <dock:DockControl.DataTemplates>
          <v:DockViewLocator />
        </dock:DockControl.DataTemplates>
      </dock:DockControl>
      <!-- Tab 隱藏所有面板時只顯示預覽 -->
      <v:PreviewView DataContext="{Binding Preview}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PanelsHidden}" />

      <!-- ToastBar：底列上方的非阻斷提示 -->
      <Border Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
              IsVisible="{Binding Toast.IsVisible}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding Toast.Message}" VerticalAlignment="Center" Foreground="{DynamicResource FB.ToolTipTextBrush}" />
          <Button Content="{l:Tr Toast.Undo}" Command="{Binding Toast.UndoCommand}" IsVisible="{Binding Toast.CanUndo}"
                  Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FB.LinkBrush}" Padding="4,0" />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</Window>
