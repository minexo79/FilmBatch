<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FilmBatch.App.ViewModels"
             xmlns:l="using:FilmBatch.App.Localization"
             x:Class="FilmBatch.App.Views.PresetLibraryView"
             x:DataType="vm:PresetLibraryViewModel">
  <!-- 預設庫（計畫書 2.4.2）：分類 → 預設；拖曳到縮圖或預覽區指定；雙擊套用；數字鍵 1–9 套用釘選預設 -->
  <DockPanel Background="{DynamicResource FB.PanelBrush}">
    <!-- 標題列：面板名稱｜＋ 以目前照片建立預設 -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,10,6">
      <TextBlock Classes="panel-title" Text="{l:Tr Panel.Presets}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Name="CreateButton" Classes="tool" ToolTip.Tip="{l:Tr Cmd.CreatePreset}">
        <PathIcon Data="{StaticResource Icon.Plus}" />
      </Button>
    </Grid>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource FB.DividerBrush}" BorderThickness="0,1,0,0" Padding="10,8">
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Name="ManageButton" Classes="outline" Content="{l:Tr Presets.Manage}" />
    </Border>
    <TreeView Name="Tree" Classes="presets" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedNode}">
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="vm:PresetCategoryViewModel" ItemsSource="{Binding Presets}">
          <TextBlock Classes="category" Text="{Binding Name}" />
        </TreeDataTemplate>
        <DataTemplate DataType="vm:PresetItemViewModel">
          <Grid Name="PresetRow" ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.ShowDelay="500">
            <ToolTip.Tip>
              <StackPanel Width="280" Spacing="6">
                <Image Source="{Binding HoverPreview}" Width="264" Height="160" Stretch="Uniform"
                       IsVisible="{Binding HasHoverPreview}" />
                <TextBlock Classes="secondary small" Text="{l:Tr Presets.Rendering}" IsVisible="{Binding HoverLoading}" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
              </StackPanel>
            </ToolTip.Tip>
            <Border Grid.Column="0" Classes="color-label" Background="{Binding ColorBrush}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Classes="key-hint" IsVisible="{Binding HasPinKey}" Margin="6,0,4,0">
              <TextBlock Classes="numeric" Text="{Binding PinKey}" />
            </Border>
          </Grid>
        </DataTemplate>
      </TreeView.DataTemplates>
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:PresetCategoryViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ContextMenu>
        <ContextMenu Name="Menu">
          <MenuItem Header="{l:Tr Presets.Apply}" Command="{Binding ApplyCommand}" CommandParameter="{Binding SelectedPreset}" />
          <Separator />
          <MenuItem Header="{l:Tr Presets.Rename}" Command="{Binding RenameCommand}" CommandParameter="{Binding SelectedPreset}" />
          <MenuItem Header="{l:Tr Presets.Color}" Command="{Binding CycleColorCommand}" CommandParameter="{Binding SelectedPreset}" />
          <MenuItem Header="{l:Tr Presets.Pin}" Command="{Binding TogglePinCommand}" CommandParameter="{Binding SelectedPreset}" />
          <MenuItem Header="{l:Tr Presets.Duplicate}" Command="{Binding DuplicateCommand}" CommandParameter="{Binding SelectedPreset}" />
          <MenuItem Header="{l:Tr Presets.Delete}" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedPreset}" />
          <Separator />
          <MenuItem Header="{l:Tr Presets.Reveal}" Command="{Binding RevealCommand}" />
        </ContextMenu>
      </TreeView.ContextMenu>
    </TreeView>
  </DockPanel>
</UserControl>
