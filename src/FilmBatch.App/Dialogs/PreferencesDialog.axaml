<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:FilmBatch.App.ViewModels.Dialogs"
        xmlns:l="using:FilmBatch.App.Localization"
        x:Class="FilmBatch.App.Dialogs.PreferencesDialog"
        x:DataType="d:PreferencesViewModel"
        Title="{l:Tr Dialog.Preferences}" Width="780" Height="540" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- 偏好設定（計畫書 2.8）：左側分類、右側設定卡片；每列為「名稱＋說明｜控制項」 -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialog-footer">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="secondary small" Text="{l:Tr Pref.ApplyNote}" TextWrapping="Wrap" />
          <TextBlock Classes="warning small" Text="{Binding ApplyError}" IsVisible="{Binding HasApplyError}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Name="CloseButton" Classes="accent" Content="{l:Tr Dialog.Close}" IsDefault="True" IsCancel="True" />
      </Grid>
    </Border>

    <!-- 分類導覽 -->
    <Border DockPanel.Dock="Left" Classes="settings-nav">
      <ListBox Name="SectionList" Classes="settings-nav" SelectedIndex="0">
        <ListBoxItem Content="{l:Tr Pref.Section.General}" />
        <ListBoxItem Content="{l:Tr Pref.Section.Preview}" />
        <ListBoxItem Content="{l:Tr Pref.Section.Gpu}" />
        <ListBoxItem Content="{l:Tr Pref.Section.Folders}" />
      </ListBox>
    </Border>

    <ScrollViewer Name="ContentScroll">
      <Panel Margin="24,20,24,20">
        <!-- 一般 -->
        <StackPanel Name="GeneralSection" Spacing="12">
          <TextBlock Classes="panel-title" Text="{l:Tr Pref.Section.General}" />
          <Border Classes="settings-card">
            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settings-label">
                <TextBlock Text="{l:Tr Cmd.Language}" />
                <TextBlock Classes="settings-desc" Text="{l:Tr Pref.Language.Desc}" />
              </StackPanel>
              <ComboBox Grid.Column="1" Classes="settings-control" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- 預覽 -->
        <StackPanel Name="PreviewSection" Spacing="12" IsVisible="False">
          <TextBlock Classes="panel-title" Text="{l:Tr Pref.Section.Preview}" />
          <Border Classes="settings-card">
            <StackPanel>
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settings-label">
                  <TextBlock Text="{l:Tr Pref.Background}" />
                  <TextBlock Classes="settings-desc" Text="{l:Tr Pref.Background.Desc}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="settings-control" ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding Background}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" />
              </Grid>
              <Border Classes="settings-divider" />
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settings-label">
                  <TextBlock Text="{l:Tr Pref.ProxySize}" />
                  <TextBlock Classes="settings-desc" Text="{l:Tr Pref.ProxySize.Desc}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="settings-control" ItemsSource="{Binding ProxySizes}" SelectedItem="{Binding ProxySizeOption}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- GPU 與效能 -->
        <StackPanel Name="GpuSection" Spacing="12" IsVisible="False">
          <TextBlock Classes="panel-title" Text="{l:Tr Pref.Section.Gpu}" />
          <Border Classes="settings-card">
            <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settings-label">
                <TextBlock Text="{l:Tr Pref.BackgroundCpu}" />
                <TextBlock Classes="settings-desc" Text="{l:Tr Pref.BackgroundCpu.Desc}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <NumericUpDown Name="BackgroundCpuBudget" Value="{Binding BackgroundCpuPercent}" Minimum="10" Maximum="100"
                               Increment="10" FormatString="0" Width="120" ShowButtonSpinner="True" />
                <TextBlock Text="%" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settings-card">
            <StackPanel>
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settings-label">
                  <TextBlock Text="{l:Tr Pref.CurrentGpu}" />
                  <TextBlock Classes="settings-desc" Text="{Binding CurrentAdapter}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Border Classes="settings-divider" />
              <StackPanel Classes="settings-row-block">
                <TextBlock Text="{l:Tr Pref.Adapters}" />
                <ItemsControl ItemsSource="{Binding Adapters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="settings-desc" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="settings-card">
            <StackPanel>
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settings-label">
                  <TextBlock Text="{l:Tr Pref.Backend}" />
                  <TextBlock Classes="settings-desc" Text="{l:Tr Pref.Backend.Desc}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Classes="settings-control" ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" />
              </Grid>
              <Border Classes="settings-divider" />
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settings-label">
                  <TextBlock Text="{l:Tr Pref.ForceSoftware}" />
                  <TextBlock Classes="settings-desc" Text="{l:Tr Pref.ForceSoftware.Desc}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceSoftware}" OnContent="" OffContent="" MinWidth="0" />
              </Grid>
              <Border Classes="settings-divider" />
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settings-label">
                  <TextBlock Text="{l:Tr Pref.GpuMemory}" />
                  <TextBlock Classes="settings-desc" Text="{l:Tr Pref.GpuMemory.Desc}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Value="{Binding GpuMemoryLimitMb}" Minimum="256" Maximum="65536" Increment="256"
                                 FormatString="0" Width="120" ShowButtonSpinner="True" />
                  <TextBlock Classes="secondary" Text="MB" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 資料夾 -->
        <StackPanel Name="FoldersSection" Spacing="12" IsVisible="False">
          <TextBlock Classes="panel-title" Text="{l:Tr Pref.Section.Folders}" />
          <Border Classes="settings-card">
            <StackPanel Classes="settings-row-block">
              <StackPanel Classes="settings-label">
                <TextBlock Text="{l:Tr Pref.Textures}" />
                <TextBlock Classes="settings-desc" Text="{l:Tr Pref.Textures.Desc}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding TexturesFolder}" />
                <Button Grid.Column="1" Classes="outline" Content="{l:Tr Pref.Browse}" Command="{Binding BrowseTexturesCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="settings-card">
            <StackPanel Classes="settings-row-block">
              <StackPanel Classes="settings-label">
                <TextBlock Text="{l:Tr Pref.LensDatabase}" />
                <TextBlock Classes="settings-desc" Text="{l:Tr Pref.LensDatabase.Desc}" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding LensDatabaseFolder}" PlaceholderText="{l:Tr Pref.LensDatabase.None}" />
                <Button Grid.Column="1" Classes="outline" Content="{l:Tr Pref.Browse}" Command="{Binding BrowseLensDatabaseCommand}" />
                <Button Grid.Column="2" Classes="outline" Content="{l:Tr Pref.Clear}" Command="{Binding ClearLensDatabaseCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</Window>
