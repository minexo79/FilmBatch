<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:FilmBatch.App.ViewModels.Dialogs"
        xmlns:s="using:FilmBatch.App.Services"
        xmlns:l="using:FilmBatch.App.Localization"
        x:Class="FilmBatch.App.Dialogs.PreferencesDialog"
        x:DataType="d:PreferencesViewModel"
        Title="{l:Tr Dialog.Preferences}" Width="560" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- 偏好設定（計畫書 2.8） -->
  <StackPanel Margin="16" Spacing="10">
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
      <TextBlock Grid.Row="0" Text="預覽背景" VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding Background}" HorizontalAlignment="Stretch" />

      <TextBlock Grid.Row="1" Text="預覽代理圖尺寸" VerticalAlignment="Center" />
      <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProxySizes}" SelectedItem="{Binding ProxySize}" Width="120" />

      <TextBlock Grid.Row="2" Text="目前 GPU" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentAdapter}" VerticalAlignment="Center" />

      <TextBlock Grid.Row="3" Text="可用介面卡" VerticalAlignment="Top" />
      <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Adapters}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Classes="small" Text="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Grid.Row="4" Text="GPU 後端" VerticalAlignment="Center" />
      <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding Backend}" MinWidth="180" />
        <CheckBox Content="強制軟體介面卡" IsChecked="{Binding ForceSoftware}" />
      </StackPanel>

      <TextBlock Grid.Row="5" Text="GPU 記憶體上限" VerticalAlignment="Center" />
      <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <NumericUpDown Value="{Binding GpuMemoryLimitMb}" Minimum="256" Maximum="65536" Increment="256" Width="90" />
        <TextBlock Text="MB" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="6" Text="材質庫資料夾" VerticalAlignment="Center" />
      <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TexturesFolder}" />

      <TextBlock Grid.Row="7" Text="LUT 資料夾" VerticalAlignment="Center" />
      <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding LutsFolder}" />

      <TextBlock Grid.Row="8" Text="{l:Tr Cmd.Language}" VerticalAlignment="Center" />
      <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="160" />
    </Grid>
    <TextBlock Classes="secondary small" TextWrapping="Wrap"
               Text="預覽背景與語言立即生效；GPU 後端、介面卡與代理圖尺寸於下次啟動生效（M3 起即時重建裝置）。" />
    <Button Name="CloseButton" Classes="accent" Content="{l:Tr Dialog.Close}" IsDefault="True" HorizontalAlignment="Right" />
  </StackPanel>
</Window>
