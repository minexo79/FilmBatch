<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:FilmBatch.App.ViewModels.Dialogs"
        xmlns:l="using:FilmBatch.App.Localization"
        x:Class="FilmBatch.App.Dialogs.PresetManagerDialog"
        x:DataType="d:PresetManagerViewModel"
        Title="{l:Tr Dialog.PresetManager}" Width="640" Height="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- 預設變更會持久化；刪除前提示使用中的照片數，專案保留舊快照。 -->
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
      <Button Content="{l:Tr Presets.ImportYaml}" Command="{Binding ImportCommand}" Margin="0,0,6,0" />
      <Button Grid.Column="1" Content="{l:Tr Presets.ExportYaml}" Command="{Binding ExportCommand}" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <Button Content="{l:Tr Presets.Delete}" Command="{Binding DeleteCommand}" />
        <Button Name="CloseButton" Classes="accent" Content="{l:Tr Dialog.Close}" IsDefault="True" />
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="24,*,140,120,96" Margin="4,0,4,4">
      <TextBlock Grid.Column="1" Classes="group-title" Text="{l:Tr Presets.Col.Name}" />
      <TextBlock Grid.Column="2" Classes="group-title" Text="{l:Tr Presets.Col.Category}" />
      <TextBlock Grid.Column="3" Classes="group-title" Text="{l:Tr Presets.Col.Color}" />
      <TextBlock Grid.Column="4" Classes="group-title" Text="{l:Tr Presets.Col.InUse}" />
    </Grid>
    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="{DynamicResource FB.BaseBrush}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="d:PresetRowViewModel">
          <Grid ColumnDefinitions="24,*,140,120,96" ColumnSpacing="6">
            <Border Classes="color-label" Background="{Binding ColorBrush}" />
            <TextBox Grid.Column="1" Text="{Binding Name}" />
            <TextBox Grid.Column="2" Text="{Binding Category}" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding $parent[Window].((d:PresetManagerViewModel)DataContext).ColorLabels}"
                      SelectedItem="{Binding ColorLabel}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="color-label" Background="{Binding}" />
                    <TextBlock Text="{Binding}" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="4" Classes="secondary small" Text="{Binding UsersText}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
