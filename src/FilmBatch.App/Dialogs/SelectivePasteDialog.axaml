<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:FilmBatch.App.ViewModels.Dialogs"
        xmlns:l="using:FilmBatch.App.Localization"
        x:Class="FilmBatch.App.Dialogs.SelectivePasteDialog"
        x:DataType="d:SelectivePasteViewModel"
        Title="{l:Tr Dialog.SelectivePaste}" Width="520" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <!-- 選擇性貼上（計畫書 2.8）：16 個模組分組勾選、包含隨機種子、貼上時鏡像位置 -->
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox Content="{l:Tr Dialog.IncludeSeeds}" IsChecked="{Binding IncludeSeeds}" ToolTip.Tip="預設不複製：漏光、顆粒、灰塵等隨機效果每張照片保持各自的形狀" />
        <CheckBox Content="{l:Tr Dialog.MirrorPositions}" IsChecked="{Binding MirrorPositions}" ToolTip.Tip="位置類參數水平鏡像，方便橫直幅混用" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:Tr Dialog.SelectAll}" Command="{Binding SelectAllCommand}" />
          <Button Content="{l:Tr Dialog.SelectNone}" Command="{Binding SelectNoneCommand}" />
          <Button Content="{l:Tr Dialog.ColorOnly}" Command="{Binding ColorOnlyCommand}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Name="PasteButton" Classes="accent" Content="{l:Tr Dialog.Paste}" IsDefault="True" />
          <Button Name="CancelButton" Content="{l:Tr Dialog.Cancel}" IsCancel="True" />
        </StackPanel>
      </Grid>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="d:ModuleCheckGroupViewModel">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Classes="group-title" Text="{Binding Label}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Modules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="d:ModuleCheckViewModel">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</Window>
