<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:FilmBatch.App.Localization"
        xmlns:g="using:FilmBatch.App.Gallery"
        xmlns:vm="using:FilmBatch.App.ViewModels"
        xmlns:c="using:FilmBatch.App.Controls"
        xmlns:p="using:FilmBatch.Core.Params"
        x:Class="FilmBatch.App.Gallery.GalleryWindow"
        x:DataType="g:GalleryViewModel"
        Title="{l:Tr Gallery.WindowTitle}" Width="1180" Height="860">
  <!--
    元件展示視窗（計畫書 2.11 #2）：列出所有自訂元件的各種狀態，用來檢查主題一致性。
    一般／停用／被覆寫／多選為靜態展示；滑鼠停留與按下請直接以滑鼠操作檢查。以 gallery 參數（雙連字號）啟動。
  -->
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="22">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="{l:Tr Cmd.Gallery}" />

      <!-- ───── 配色 ───── -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-title" Text="{l:Tr Gallery.Colors}" />
        <ItemsControl ItemsSource="{Binding Swatches}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="g:GallerySwatch">
              <Border Width="170" Margin="0,0,8,8" Padding="6" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource FB.BorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="28" Height="28" CornerRadius="2" Background="{Binding Brush}" BorderBrush="{DynamicResource FB.BorderLightBrush}" BorderThickness="1" />
                  <StackPanel>
                    <TextBlock Classes="small" Text="{Binding Token}" />
                    <TextBlock Classes="small secondary numeric" Text="{Binding Hex}" />
                    <TextBlock Classes="small" Text="{Binding Check}" Classes.secondary="{Binding IsNeutral}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- ───── 按鈕與輸入 ───── -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-title" Text="{l:Tr Gallery.Inputs}" />
        <WrapPanel>
          <Button Content="{l:Tr Gallery.Button}" Margin="0,0,8,8" />
          <Button Classes="accent" Content="{l:Tr Gallery.AccentButton}" Margin="0,0,8,8" />
          <Button Content="{l:Tr Gallery.DisabledButton}" IsEnabled="False" Margin="0,0,8,8" />
          <Button Classes="tool" ToolTip.Tip="{l:Tr Gallery.ToolButton}"><PathIcon Data="{StaticResource Icon.Open}" /></Button>
          <Button Classes="tool" IsEnabled="False" ToolTip.Tip="{l:Tr Gallery.DisabledToolButton}"><PathIcon Data="{StaticResource Icon.Undo}" /></Button>
          <ToggleButton Classes="tool" IsChecked="True" ToolTip.Tip="{l:Tr Gallery.ToggledOn}"><PathIcon Data="{StaticResource Icon.Compare}" /></ToggleButton>
          <ToggleButton Classes="tool" ToolTip.Tip="{l:Tr Gallery.ToggledOff}"><PathIcon Data="{StaticResource Icon.Compare}" /></ToggleButton>
        </WrapPanel>
        <WrapPanel>
          <ComboBox SelectedIndex="0" Width="140" Margin="0,0,8,8">
            <ComboBoxItem Content="Portra 400" />
            <ComboBoxItem Content="Ektar 100" />
          </ComboBox>
          <ComboBox SelectedIndex="0" Width="140" IsEnabled="False" Margin="0,0,8,8">
            <ComboBoxItem Content="{l:Tr Gallery.Disabled}" />
          </ComboBox>
          <TextBox Width="160" PlaceholderText="{l:Tr Gallery.Placeholder}" Margin="0,0,8,8" />
          <TextBox Width="160" Text="{l:Tr Gallery.Disabled}" IsEnabled="False" Margin="0,0,8,8" />
          <NumericUpDown Width="70" Value="42" Margin="0,0,8,8" />
          <CheckBox Content="{l:Tr Gallery.Checked}" IsChecked="True" Margin="0,0,8,8" />
          <CheckBox Content="{l:Tr Gallery.Unchecked}" Margin="0,0,8,8" />
          <CheckBox Content="{l:Tr Gallery.Disabled}" IsEnabled="False" IsChecked="True" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>

      <!-- ───── 參數列 ───── -->
      <Grid ColumnDefinitions="*,24,*">
        <StackPanel Spacing="4">
          <TextBlock Classes="group-title" Text="{l:Tr Gallery.ParamRow}" />
          <c:ParamRow DataContext="{Binding NormalParam}" />
          <c:ParamRow DataContext="{Binding OverriddenParam}" />
          <c:ParamRow DataContext="{Binding NormalParam}" IsEnabled="False" />
          <TextBlock Classes="small secondary" Text="{l:Tr Gallery.ParamSlider}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Classes="group-title" Text="ChoiceRow／Toggle" />
          <Grid ColumnDefinitions="*,Auto" Classes="param-line" DataContext="{Binding ChoiceParam}" x:DataType="vm:ChoiceParamViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="param-name" Classes.overridden="{Binding IsOverridden}" Text="{Binding Label}" />
              <Ellipse Classes="override-dot" IsVisible="{Binding IsOverridden}" />
            </StackPanel>
            <ComboBox Grid.Column="1" Classes="flat" MinWidth="150" VerticalAlignment="Center" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                      DisplayMemberBinding="{Binding Label, x:DataType=vm:ChoiceItem}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Classes="param-line" DataContext="{Binding ToggleParam}" x:DataType="vm:ToggleParamViewModel">
            <TextBlock Classes="param-name" Text="{Binding Label}" />
            <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Value}" OnContent="" OffContent="" />
          </Grid>
        </StackPanel>
      </Grid>

      <!-- ───── 模組區塊 ───── -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-title" Text="{l:Tr Gallery.ModuleSection}" />
        <Grid ColumnDefinitions="*,16,*,16,*">
          <ContentControl Grid.Column="0" Content="{Binding EnabledModule}" ContentTemplate="{StaticResource GalleryModuleTemplate}" />
          <ContentControl Grid.Column="2" Content="{Binding DisabledModule}" ContentTemplate="{StaticResource GalleryModuleTemplate}" />
          <ContentControl Grid.Column="4" Content="{Binding CollapsedModule}" ContentTemplate="{StaticResource GalleryModuleTemplate}" />
        </Grid>
      </StackPanel>

      <!-- ───── 縮圖 ───── -->
      <StackPanel Spacing="8">
        <TextBlock Classes="group-title" Text="{l:Tr Gallery.Thumbnail}" />
        <ListBox Name="Thumbs" Classes="filmstrip" ItemsSource="{Binding Thumbnails}" SelectionMode="Multiple" Height="112" CornerRadius="8">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ThumbnailViewModel">
              <Border Classes="thumb" ToolTip.Tip="{Binding FileName}">
              <Grid Width="128" Height="88">
                <Image Source="{Binding Bitmap}" Stretch="Uniform" />
                <PathIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource FB.ErrorBrush}"
                          IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="5,1" CornerRadius="8" Background="#B0141414">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Classes="color-label" Width="6" Height="6" CornerRadius="3" Background="{Binding PresetBrush}" />
                    <TextBlock FontSize="10" Text="{Binding PresetLabel}" Foreground="#EAEAEA" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                  <PathIcon Data="{StaticResource Icon.Sync}" Width="10" Height="10" Foreground="{DynamicResource FB.PresetUpdatedBrush}" IsVisible="{Binding PresetUpdated}" />
                  <Ellipse Classes="override-dot" Width="8" Height="8" IsVisible="{Binding HasOverrides}" />
                </StackPanel>
                <TextBlock Text="{Binding FileName}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3" Foreground="#EAEAEA" />
              </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- ───── 預設、提示、畫布 ───── -->
      <Grid ColumnDefinitions="260,24,*">
        <StackPanel Spacing="8">
          <TextBlock Classes="group-title" Text="{l:Tr Gallery.PresetItem}" />
          <ListBox Classes="presets" ItemsSource="{Binding PresetItems}" SelectedIndex="1" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PresetItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Summary}" ToolTip.ShowDelay="500">
                  <Border Classes="color-label" Background="{Binding ColorBrush}" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" />
                  <TextBlock Grid.Column="2" Classes="secondary small numeric" Text="{Binding PinKey}" Margin="6,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="group-title" Text="ToastBar" Margin="0,8,0,0" />
          <Border Classes="toast" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{l:Tr Gallery.ToastSample}" VerticalAlignment="Center" Foreground="{DynamicResource FB.ToolTipTextBrush}" />
              <Button Content="{l:Tr Toast.Undo}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FB.LinkBrush}" Padding="4,0" />
            </StackPanel>
          </Border>
          <TextBlock Classes="group-title" Text="{l:Tr Gallery.StatusBar}" Margin="0,8,0,0" />
          <Border Classes="statusbar">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
              <PathIcon Data="{StaticResource Icon.Warning}" Width="11" Height="11" Foreground="{DynamicResource FB.WarningTextBrush}" />
              <TextBlock Classes="warning" Text="Microsoft Basic Render Driver · DX12" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Classes="group-title" Text="{l:Tr Gallery.PreviewCanvas}" />
          <c:PreviewCanvas Name="Canvas" Height="260" Image="{Binding Sample}" Original="{Binding SampleOriginal}"
                           IsSplit="True" SplitPosition="0.4" IsBusy="True" ShowsSpinner="True" OverlayText="{l:Tr Gallery.OverlaySample}"
                           ControlPoint="0.65,0.45" CanvasBackground="#161616" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>

  <Window.Resources>
    <DataTemplate x:Key="GalleryModuleTemplate" x:DataType="vm:ModuleSectionViewModel">
      <c:ModuleSection Header="{Binding Label}" IsExpanded="{Binding IsExpanded}" IsModuleEnabled="{Binding IsModuleEnabled}" OverrideCount="{Binding OverrideCount}">
        <c:ModuleSection.HeaderFlyout>
          <MenuFlyout>
            <MenuItem Header="{l:Tr Inspector.ResetModule}" />
            <MenuItem Header="{l:Tr Inspector.CopyModule}" />
          </MenuFlyout>
        </c:ModuleSection.HeaderFlyout>
        <ItemsControl ItemsSource="{Binding Params}">
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:SliderParamViewModel">
              <c:ParamRow />
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </c:ModuleSection>
    </DataTemplate>
  </Window.Resources>
</Window>
