<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FilmBatch.App.ViewModels"
             xmlns:l="using:FilmBatch.App.Localization"
             x:Class="FilmBatch.App.Controls.FilmRecipeControl"
             x:DataType="vm:FilmRecipeViewModel">
  <!-- 底片配方選擇（計畫書 5.3.11、7.5）：品牌分組下拉＋EDITED/重設/匯入匯出。放在 film 模組區塊頂部。 -->
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto" Classes="param-line">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Classes="param-name" Text="{l:Tr Film.Recipe}" />
        <Border Classes="edited-badge" IsVisible="{Binding IsEdited}">
          <TextBlock Classes="small" Text="{l:Tr Film.Edited}" />
        </Border>
      </StackPanel>
      <Button Grid.Column="1" Classes="outline" Content="{l:Tr Film.ResetToRecipe}"
              Command="{Binding ResetToRecipeCommand}" IsVisible="{Binding IsEdited}" />
    </Grid>
    <ComboBox Classes="flat" HorizontalAlignment="Stretch"
              ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
              DisplayMemberBinding="{Binding Brand}"
              AutomationProperties.Name="{l:Tr Film.Recipe}" />
    <ComboBox Classes="flat" HorizontalAlignment="Stretch"
              ItemsSource="{Binding SelectedGroup.Recipes}" SelectedItem="{Binding Selected}"
              DisplayMemberBinding="{Binding Name}"
              AutomationProperties.Name="{l:Tr Film.Recipe}" />
    <TextBlock Classes="small warning" Text="{Binding UnsupportedEffectText}"
               IsVisible="{Binding HasUnsupportedEffect}" />
    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
      <Button Classes="outline" Content="{l:Tr Film.SaveAsCustom}" Command="{Binding SaveAsCustomCommand}" />
      <Button Classes="outline" Content="{l:Tr Film.Import}" Command="{Binding ImportCommand}" />
      <Button Classes="outline" Content="{l:Tr Film.Export}" Command="{Binding ExportCommand}" />
    </WrapPanel>
  </StackPanel>
</UserControl>
