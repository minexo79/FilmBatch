<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FilmBatch</AssemblyName>
    <RootNamespace>FilmBatch.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- 發佈設定（見計畫書 9.3）：self-contained 資料夾發佈 + ReadyToRun，不啟用 Trimming。
       GUI 相依的 Avalonia / Dock 以反射驅動樣式、版面序列化與樣板查找，即使以
       TrimmerRootAssembly 逐一套住仍會產生 IL2104 且不保證執行期安全；不修剪可根除
       警告並確保發佈版與開發版行為一致（M7 前的 Native AOT 評估另議）。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FilmBatch.App.Shared\FilmBatch.App.Shared.csproj" />
    <ProjectReference Include="..\FilmBatch.Core\FilmBatch.Core.csproj" />
    <ProjectReference Include="..\FilmBatch.Engine\FilmBatch.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FilmBatch.App.Tests" />
  </ItemGroup>
</Project>
