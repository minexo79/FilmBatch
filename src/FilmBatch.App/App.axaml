<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockFluent="using:Dock.Avalonia.Themes.Fluent"
             x:Class="FilmBatch.App.App"
             RequestedThemeVariant="Dark">
  <!-- Fluent 深色主題（不跟隨作業系統），依序：Fluent → Dock → 本專案樣式（最後載入，計畫書 2.2.1） -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FilmBatch/Themes/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <dockFluent:DockFluentTheme />
    <StyleInclude Source="avares://FilmBatch/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
