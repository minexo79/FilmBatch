<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockFluent="using:Dock.Avalonia.Themes.Fluent"
             x:Class="FilmBatch.App.App"
             Name="FilmBatch"
             RequestedThemeVariant="Dark">
  <!-- Fluent 深色主題（不跟隨作業系統），依序：Fluent → Dock → 本專案樣式（最後載入，計畫書 2.2.1） -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FilmBatch.App.Shared/Themes/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <dockFluent:DockFluentTheme />
    <StyleInclude Source="avares://FilmBatch.App.Shared/Themes/Controls.axaml" />
    <StyleInclude Source="avares://FilmBatch/Themes/DesktopDock.axaml" />
  </Application.Styles>
  <!-- macOS 應用程式選單的根：Avalonia 在初始化完成前就匯出它，之後換根不會生效。
       NativeMenus 只在開頭插入「關於」與「偏好設定」；其他平台忽略 -->
  <NativeMenu.Menu>
    <NativeMenu />
  </NativeMenu.Menu>
</Application>
