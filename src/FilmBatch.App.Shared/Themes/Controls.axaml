<!--
  自訂元件與 Fluent 控制項的樣式（計畫書 2.2.1）。集中於此、最後載入，不散落在各 View。
  風格：扁平、圓角、少框線，接近 Lightroom 跨平台版／RapidRAW 的現代修圖介面：
  - 面板以明度層次區分，不用框線與標題條；Dock 的 IDE 式工具標題列與文件分頁一律隱藏（版面仍可用分隔線調整大小）。
  - 參數列為兩行式：「名稱｜數值」在上、整寬細滑桿在下；滑桿為空心圓鈕。
  - 模組停用時內容淡化但仍可調整：以 :module-disabled + Opacity 實作（不用 IsEnabled=false）。
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:FilmBatch.App.Controls"
        xmlns:l="using:FilmBatch.App.Localization">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Fluent 尺寸資源 -->
      <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
      <Thickness x:Key="TextControlThemePadding">8,4,8,4</Thickness>
      <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
      <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
      <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
      <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
      <Thickness x:Key="SliderTopHeaderMargin">0</Thickness>
      <x:Double x:Key="ComboBoxMinHeight">28</x:Double>
      <Thickness x:Key="ComboBoxPadding">10,4,0,4</Thickness>
      <x:Double x:Key="MenuFlyoutThemeMinHeight">28</x:Double>

      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FilmBatch.App.Shared/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ───── 視窗 ───── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ───── 標題列與選單列合一 ─────
       主視窗把內容延伸進標題列（ExtendClientAreaToDecorationsHint），自行在同一列顯示選單與常用動作；
       隱藏 Fluent 繪製的標題文字，只保留系統按鈕。對話框使用原生標題列，不受影響。 -->
  <Style Selector=":is(Control)#PART_TitleTextPanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Grid.topbar">
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
  </Style>
  <Style Selector="Menu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="Menu > MenuItem:pointerover, Menu > MenuItem:open">
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- ───── 底列 ───── -->
  <Style Selector="Grid.bottombar">
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
  </Style>
  <Style Selector="Grid.bottombar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="Grid.bottombar TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource FB.WarningTextBrush}" />
  </Style>

  <!-- ───── 數值欄位：等寬數字 ───── -->
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="ShowButtonSpinner" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <!-- 參數列右上的數值：平常看起來像文字，滑過或編輯時才顯示輸入框 -->
  <Style Selector="NumericUpDown.inline-value">
    <Setter Property="Width" Value="68" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown.inline-value /template/ TextBox">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="NumericUpDown.inline-value /template/ TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown.inline-value /template/ TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown.inline-value /template/ TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.BorderBrush}" />
  </Style>
  <!-- 扁平下拉：無框線，靠底色辨識 -->
  <Style Selector="ComboBox.flat">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
  </Style>
  <Style Selector="ComboBox.flat:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource FB.ButtonBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.BorderBrush}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="CheckBox.small">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <!-- 小型開關：不顯示文字、不保留 Fluent 預設的最小寬度 -->
  <Style Selector="ToggleSwitch.compact">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ToggleSwitch.compact /template/ ContentPresenter#PART_OnContentPresenter, ToggleSwitch.compact /template/ ContentPresenter#PART_OffContentPresenter, ToggleSwitch.compact /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleSwitch.compact /template/ Grid#SwitchAreaGrid">
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- ───── 滑桿：細軌道＋空心圓鈕 ─────
       以精簡樣板取代 Fluent 樣板（Fluent 的上下標題列與刻度列會擠壓圓鈕）。軌道左右各內縮半個圓鈕寬，與 ParamSlider.ThumbHalf 一致。 -->
  <Style Selector="Slider:horizontal">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border Name="TrackLine" Height="2" CornerRadius="1" Margin="7,0" VerticalAlignment="Center"
                  Background="{DynamicResource FB.SliderTrackBrush}" />
          <Track Name="PART_Track" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb Name="thumb" Width="14" Height="14" VerticalAlignment="Center" />
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider:pointerover /template/ Border#TrackLine">
    <Setter Property="Background" Value="{DynamicResource FB.BorderLightBrush}" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Template">
      <ControlTemplate>
        <Ellipse Name="ThumbEllipse" Width="14" Height="14"
                 Fill="{DynamicResource FB.SliderThumbFillBrush}"
                 Stroke="{DynamicResource FB.SliderThumbStrokeBrush}" StrokeThickness="1.5" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider:pointerover /template/ Thumb">
    <Setter Property="RenderTransform" Value="scale(1.15)" />
  </Style>
  <Style Selector="Slider:focus-within /template/ Thumb">
    <Setter Property="RenderTransform" Value="scale(1.15)" />
  </Style>

  <!-- ───── 按鈕 ───── -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource FB.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FB.AccentTextBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FB.AccentTextBrush}" />
  </Style>
  <Style Selector="Button.accent PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FB.AccentTextBrush}" />
  </Style>
  <!-- 膠囊按鈕（頂列主要動作） -->
  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- 外框按鈕（面板內的次要動作） -->
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.BorderLightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="Button.outline:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.BorderBrush}" />
  </Style>

  <!-- 工具按鈕：只有圖示、透明背景、圓角滑過底色 -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="Button.tool PathIcon, ToggleButton.tool PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="Button.tool:disabled PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FB.DisabledTextBrush}" />
  </Style>
  <Style Selector="Button.tool:disabled /template/ ContentPresenter, Button.icon:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.ButtonHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FB.AccentBrush}" />
  </Style>
  <!-- 預覽區浮動工具列：疊在畫面右上角，圓角半透明底座＋柔和陰影；按鈕之間留較寬的間距。
       算圖指示改畫在工具列左側（PreviewCanvas.SpinnerRightInset），尺寸變動時兩邊要一起調整。 -->
  <Style Selector="Border.preview-toolbar">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,14,14,0" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#E61C1C1C" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #80000000" />
  </Style>
  <Style Selector="StackPanel.preview-toolbar">
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="Border.preview-toolbar Button.tool">
    <Setter Property="Padding" Value="9" />
    <Setter Property="ToolTip.Placement" Value="Left" />
  </Style>
  <Style Selector="Border.preview-toolbar-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource FB.BorderLightBrush}" />
  </Style>
  <!-- 預覽區檢視控制：浮在預覽區正下方中央，外觀與右上角浮動工具列一致 -->
  <Style Selector="Border.preview-zoombar">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#E61C1C1C" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #80000000" />
  </Style>
  <Style Selector="Border.preview-zoombar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="Border.preview-zoombar :is(Button).tool">
    <Setter Property="ToolTip.Placement" Value="Top" />
  </Style>

  <!-- 預覽區拍攝資訊（EXIF）：浮在預覽區右下角，外觀與檢視控制列一致 -->
  <Style Selector="Border.preview-exif">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MaxWidth" Value="300" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#E61C1C1C" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #80000000" />
  </Style>
  <Style Selector="Border.preview-exif StackPanel">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="Border.preview-exif TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#B8B8B8" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.preview-exif TextBlock.title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#EAEAEA" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <!-- 小型圖示按鈕（面板內） -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>

  <Style Selector="Separator.vertical">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Background" Value="{DynamicResource FB.BorderLightBrush}" />
  </Style>

  <!-- ───── 文字 ───── -->
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource FB.PlaceholderBrush}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <!-- 面板標題：較大的字級取代標題條 -->
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.group-title">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource FB.PlaceholderBrush}" />
  </Style>
  <!-- 被覆寫的參數：名稱粗體 -->
  <Style Selector="TextBlock.overridden">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource FB.WarningTextBrush}" />
  </Style>

  <!-- ───── 標記點 ───── -->
  <Style Selector="Ellipse.override-dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource FB.OverrideBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ───── 面板 ───── -->
  <Style Selector="Border.panel-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,14,16,14" />
  </Style>

  <!-- ───── 側邊欄分頁工具列（外緣直列圖示，Lightroom 式） ───── -->
  <Style Selector="Border.tab-rail">
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="Padding" Value="6,10" />
  </Style>
  <Style Selector="RadioButton.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="RailButton" Width="36" Height="36" CornerRadius="8" Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.rail:pointerover">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="RadioButton.rail:checked">
    <Setter Property="Background" Value="{DynamicResource FB.ButtonBrush}" />
  </Style>
  <Style Selector="RadioButton.rail PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource FB.PlaceholderBrush}" />
  </Style>
  <Style Selector="RadioButton.rail:pointerover PathIcon, RadioButton.rail:checked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>

  <!-- ───── 表單欄位（照片匯出分頁）：標籤在上、控制項在下 ───── -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource FB.PlaceholderBrush}" />
  </Style>
  <Style Selector="Border.summary-card">
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- ───── 參數列 ───── -->
  <Style Selector="c|ParamRow">
    <Setter Property="Height" Value="{StaticResource FB.ParamRowHeight}" />
  </Style>
  <Style Selector="TextBlock.param-name">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.param-name.overridden">
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="Grid.param-line">
    <Setter Property="Height" Value="38" />
  </Style>

  <!-- ───── 模組區塊：標題（名稱｜覆寫數｜👁 啟用｜⋯｜折疊箭頭），區塊之間以細線分隔 ───── -->
  <Style Selector="c|ModuleSection">
    <Setter Property="Template">
      <ControlTemplate>
        <Border BorderBrush="{DynamicResource FB.DividerBrush}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="module-header" Name="PART_Header">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Height="40" Margin="16,0,8,0">
                <ToggleButton Grid.Column="0" Name="PART_Title" Classes="module-title" Content="{TemplateBinding Header}"
                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" Padding="0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0" IsVisible="{TemplateBinding HasOverrides}" VerticalAlignment="Center">
                  <Ellipse Classes="override-dot" />
                  <TextBlock Classes="numeric small" Text="{TemplateBinding OverrideCount}" Foreground="{DynamicResource FB.OverrideBrush}" />
                </StackPanel>
                <ToggleButton Grid.Column="2" Name="PART_Enabled" Classes="module-toggle" IsChecked="{TemplateBinding IsModuleEnabled, Mode=TwoWay}"
                              Focusable="False" ToolTip.Tip="{l:Tr Tip.ToggleModule}">
                  <Panel>
                    <PathIcon Classes="on" Data="{StaticResource Icon.Eye}" />
                    <PathIcon Classes="off" Data="{StaticResource Icon.EyeOff}" />
                  </Panel>
                </ToggleButton>
                <Button Grid.Column="3" Classes="icon" Flyout="{TemplateBinding HeaderFlyout}" Focusable="False" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource Icon.More}" />
                </Button>
                <ToggleButton Grid.Column="4" Classes="chevron" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" Focusable="False">
                  <Panel>
                    <PathIcon Classes="collapsed" Data="{StaticResource Icon.ChevronRight}" />
                    <PathIcon Classes="expanded" Data="{StaticResource Icon.ChevronDown}" />
                  </Panel>
                </ToggleButton>
              </Grid>
            </Border>
            <ContentPresenter Name="PART_Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}" Padding="16,0,16,12" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="c|ModuleSection /template/ Border.module-header">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="c|ModuleSection /template/ Border.module-header:pointerover">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="c|ModuleSection /template/ ToggleButton#PART_Title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="c|ModuleSection:module-disabled /template/ ContentPresenter#PART_Content">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="c|ModuleSection:module-disabled /template/ ToggleButton#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource FB.DisabledTextBrush}" />
  </Style>

  <!-- 模組啟用開關（眼睛圖示） -->
  <Style Selector="ToggleButton.module-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.module-toggle:checked /template/ ContentPresenter, ToggleButton.module-toggle:unchecked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.module-toggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="ToggleButton.module-toggle PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.module-toggle:unchecked PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource FB.DisabledTextBrush}" />
  </Style>
  <Style Selector="ToggleButton.module-toggle PathIcon.off">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.module-toggle:unchecked PathIcon.off">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleButton.module-toggle:unchecked PathIcon.on">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- 折疊箭頭 -->
  <Style Selector="ToggleButton.chevron, ToggleButton.module-title">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.chevron PathIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FB.PlaceholderBrush}" />
  </Style>
  <!-- 未展開時也必須覆寫 Fluent 預設的按鈕底色，否則會出現灰色圓角外框。 -->
  <Style Selector="ToggleButton.chevron:checked /template/ ContentPresenter, ToggleButton.chevron:unchecked /template/ ContentPresenter, ToggleButton.chevron:pointerover /template/ ContentPresenter, ToggleButton.chevron:pressed /template/ ContentPresenter, ToggleButton.module-title:checked /template/ ContentPresenter, ToggleButton.module-title:unchecked /template/ ContentPresenter, ToggleButton.module-title:pointerover /template/ ContentPresenter, ToggleButton.module-title:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.chevron PathIcon.expanded">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.chevron:checked PathIcon.expanded">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleButton.chevron:checked PathIcon.collapsed">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- 模組分組標題（整組折疊） -->
  <Style Selector="ToggleButton.group-header">
    <Setter Property="Padding" Value="16,16,16,6" />
  </Style>
  <Style Selector="ToggleButton.group-header PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>

  <!-- ───── 縮圖列 ───── -->
  <Style Selector="ListBox.filmstrip">
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="ListBox.filmstrip ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.filmstrip ListBoxItem /template/ ContentPresenter, ListBox.filmstrip ListBoxItem:pointerover /template/ ContentPresenter, ListBox.filmstrip ListBoxItem:selected /template/ ContentPresenter, ListBox.filmstrip ListBoxItem:selected:pointerover /template/ ContentPresenter, ListBox.filmstrip ListBoxItem:pressed /template/ ContentPresenter, ListBox.filmstrip ListBoxItem:selected:pressed /template/ ContentPresenter, ListBox.filmstrip ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Background" Value="{DynamicResource FB.ThumbnailBackBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="ListBox.filmstrip ListBoxItem:pointerover Border.thumb">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.BorderLightBrush}" />
  </Style>
  <!-- 選取中：亮白 2px 外框、不透明 -->
  <Style Selector="ListBox.filmstrip ListBoxItem:selected Border.thumb">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.SelectionRingBrush}" />
  </Style>
  <Style Selector="Border.drop-target">
    <Setter Property="BorderBrush" Value="{DynamicResource FB.AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ───── 底片風格（FilmLookControl）：縮圖格、「自訂」標記、色相帶色塊 ───── -->
  <Style Selector="Button.film-tile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.film-tile:pointerover /template/ ContentPresenter, Button.film-tile:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.BorderLightBrush}" />
  </Style>
  <!-- 目前套用中的底片／色相修正：強調色 2px 外框 -->
  <Style Selector="Button.film-tile.selected /template/ ContentPresenter, Button.film-tile.selected:pointerover /template/ ContentPresenter, Button.film-tile.selected:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FB.AccentBrush}" />
  </Style>
  <Style Selector="Border.film-thumb">
    <Setter Property="Background" Value="{DynamicResource FB.ThumbnailBackBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ProgressBar.film-thumb-busy">
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="Height" Value="2" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <!-- 色相值不符合任何內建修正：琥珀色「自訂」標記（與覆寫標示同色系） -->
  <Style Selector="Border.film-badge">
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.film-badge TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FB.OverrideBrush}" />
  </Style>
  <Style Selector="ListBox.hue-bands">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="ListBox.hue-bands ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.hue-bands ListBoxItem /template/ ContentPresenter, ListBox.hue-bands ListBoxItem:selected /template/ ContentPresenter, ListBox.hue-bands ListBoxItem:selected:focus /template/ ContentPresenter, ListBox.hue-bands ListBoxItem:selected:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.hue-bands ListBoxItem:pointerover /template/ ContentPresenter, ListBox.hue-bands ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <!-- 選取中的色相帶：色塊外加亮白 2px 外環（同縮圖列選取） -->
  <Style Selector="ListBox.hue-bands ListBoxItem Ellipse">
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.hue-bands ListBoxItem:selected Ellipse">
    <Setter Property="Stroke" Value="{DynamicResource FB.SelectionRingBrush}" />
  </Style>

  <!-- ───── 預設庫 ───── -->
  <Style Selector="TreeView.presets">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="TreeView.presets TreeViewItem">
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="TreeView.presets TreeViewItem /template/ Border#PART_LayoutRoot">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TreeView.presets TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="TreeView.presets TreeViewItem:selected /template/ Border#PART_LayoutRoot, TreeView.presets TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource FB.ButtonBrush}" />
  </Style>
  <Style Selector="TextBlock.category">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="Border.key-hint">
    <Setter Property="Background" Value="{DynamicResource FB.BaseBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key-hint TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="ListBox.presets ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.ButtonBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
  </Style>
  <Style Selector="Border.color-label">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ───── 提示、舊版狀態列（對話框沿用） ───── -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource FB.ToolTipBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #A0000000" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <!-- ───── 設定類對話框（偏好設定、關於）：左側分類、設定卡片、底部按鈕列 ───── -->
  <Style Selector="Border.dialog-footer">
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,12" />
  </Style>
  <Style Selector="Border.settings-nav">
    <Setter Property="Width" Value="190" />
    <Setter Property="Background" Value="{DynamicResource FB.WindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FB.DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="10,16" />
  </Style>
  <Style Selector="ListBox.settings-nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource FB.SecondaryTextBrush}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.HoverOverlayBrush}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FB.ButtonBrush}" />
  </Style>
  <Style Selector="ListBox.settings-nav ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource FB.TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource FB.PanelBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,4" />
  </Style>
  <Style Selector="Grid.settings-row">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="ColumnSpacing" Value="24" />
  </Style>
  <Style Selector="StackPanel.settings-row-block">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="0,12" />
  </Style>
  <Style Selector="StackPanel.settings-label">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.settings-desc">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FB.PlaceholderBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Grid.settings-row > ComboBox.settings-control, Grid.settings-row > ToggleSwitch, Grid.settings-row > StackPanel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.settings-control">
    <Setter Property="Width" Value="240" />
  </Style>
  <Style Selector="Border.settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource FB.DividerBrush}" />
  </Style>
  <Style Selector="Grid.package-row">
    <Setter Property="Margin" Value="16,8" />
    <Setter Property="ColumnSpacing" Value="12" />
  </Style>
  <Style Selector="Border.package-divider">
    <Setter Property="BorderBrush" Value="{DynamicResource FB.DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="HyperlinkButton">
    <Setter Property="Foreground" Value="{DynamicResource FB.LinkBrush}" />
  </Style>
</Styles>
