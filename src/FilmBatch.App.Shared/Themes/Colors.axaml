<!--
  FilmBatch 配色（計畫書 2.2.2）。所有介面灰階 R = G = B；強調色只用於「選取」與「主要動作」，琥珀色只標示「被覆寫」。
  風格走向：扁平、深色、圓角、少框線（接近 Lightroom 跨平台版／RapidRAW），以明度層次而非框線區分區塊：
    畫布（最暗）＜ 標題列／底列 ＜ 側面板 ＜ 輸入框 ＜ 按鈕。
  覆寫 Fluent 與 Dock 的系統資源，並定義本專案的色彩 token（FB.*）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- ── 覆寫 Fluent 系統資源 ── -->
      <Color x:Key="SystemAccentColor">#3D8EF0</Color>
      <Color x:Key="SystemAccentColorLight1">#5AA0F3</Color>
      <Color x:Key="SystemAccentColorLight2">#7FB5F6</Color>
      <Color x:Key="SystemAccentColorLight3">#A6CBF9</Color>
      <Color x:Key="SystemAccentColorDark1">#2F7AD6</Color>
      <Color x:Key="SystemAccentColorDark2">#2565B4</Color>
      <Color x:Key="SystemAccentColorDark3">#1C5092</Color>
      <Color x:Key="SystemRegionColor">#232323</Color>
      <Color x:Key="RegionColor">#232323</Color>
      <!-- Fluent 深色的 chrome 與清單灰階，統一改為中性灰 -->
      <Color x:Key="SystemAltHighColor">#1C1C1C</Color>
      <Color x:Key="SystemAltMediumHighColor">#1C1C1C</Color>
      <Color x:Key="SystemChromeLowColor">#1C1C1C</Color>
      <Color x:Key="SystemChromeMediumLowColor">#262626</Color>
      <Color x:Key="SystemChromeMediumColor">#2C2C2C</Color>
      <Color x:Key="SystemChromeHighColor">#454545</Color>
      <Color x:Key="SystemChromeAltLowColor">#E6E6E6</Color>
      <Color x:Key="SystemChromeDisabledLowColor">#6A6A6A</Color>
      <Color x:Key="SystemChromeDisabledHighColor">#3A3A3A</Color>
      <Color x:Key="SystemBaseHighColor">#E6E6E6</Color>
      <Color x:Key="SystemBaseMediumHighColor">#C4C4C4</Color>
      <Color x:Key="SystemBaseMediumColor">#9C9C9C</Color>
      <Color x:Key="SystemBaseMediumLowColor">#6A6A6A</Color>
      <Color x:Key="SystemBaseLowColor">#333333</Color>
      <Color x:Key="SystemListLowColor">#2C2C2C</Color>
      <Color x:Key="SystemListMediumColor">#353535</Color>

      <!-- ── 本專案色彩 token ── -->
      <SolidColorBrush x:Key="FB.WindowBrush" Color="#1C1C1C" />
      <SolidColorBrush x:Key="FB.CanvasBrush" Color="#161616" />
      <SolidColorBrush x:Key="FB.PanelBrush" Color="#232323" />
      <SolidColorBrush x:Key="FB.OverlayBrush" Color="#B0000000" />
      <SolidColorBrush x:Key="FB.TextBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="FB.SecondaryTextBrush" Color="#A0A0A0" />
      <SolidColorBrush x:Key="FB.BaseBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="FB.AlternateBaseBrush" Color="#262626" />
      <SolidColorBrush x:Key="FB.ButtonBrush" Color="#333333" />
      <SolidColorBrush x:Key="FB.ButtonHoverBrush" Color="#3D3D3D" />
      <SolidColorBrush x:Key="FB.ButtonPressedBrush" Color="#2A2A2A" />
      <SolidColorBrush x:Key="FB.HoverOverlayBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="FB.PlaceholderBrush" Color="#7C7C7C" />
      <SolidColorBrush x:Key="FB.ToolTipBackgroundBrush" Color="#333333" />
      <SolidColorBrush x:Key="FB.ToolTipTextBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="FB.BorderLightBrush" Color="#4A4A4A" />
      <SolidColorBrush x:Key="FB.BorderBrush" Color="#2E2E2E" />
      <SolidColorBrush x:Key="FB.DividerBrush" Color="#2C2C2C" />
      <SolidColorBrush x:Key="FB.ShadowBrush" Color="#141414" />
      <SolidColorBrush x:Key="FB.ShadowDarkBrush" Color="#0E0E0E" />
      <SolidColorBrush x:Key="FB.ThumbnailBackBrush" Color="#121212" />
      <SolidColorBrush x:Key="FB.AccentBrush" Color="#3D8EF0" />
      <SolidColorBrush x:Key="FB.AccentHoverBrush" Color="#5AA0F3" />
      <SolidColorBrush x:Key="FB.AccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FB.SelectionRingBrush" Color="#F2F2F2" />
      <SolidColorBrush x:Key="FB.WarningTextBrush" Color="#FF6B6B" />
      <SolidColorBrush x:Key="FB.LinkBrush" Color="#6AAAF5" />
      <SolidColorBrush x:Key="FB.DisabledTextBrush" Color="#666666" />
      <SolidColorBrush x:Key="FB.DisabledAccentBrush" Color="#4A4A4A" />
      <!-- 畫布工具：裁切框外的半透明遮罩、框內格線（灰階 R = G = B） -->
      <SolidColorBrush x:Key="FB.CanvasScrimBrush" Color="#A0000000" />
      <SolidColorBrush x:Key="FB.CropGuideBrush" Color="#90FFFFFF" />

      <!-- 滑桿 -->
      <SolidColorBrush x:Key="FB.SliderTrackBrush" Color="#4A4A4A" />
      <SolidColorBrush x:Key="FB.SliderThumbFillBrush" Color="#232323" />
      <SolidColorBrush x:Key="FB.SliderThumbStrokeBrush" Color="#E6E6E6" />

      <!-- 語意色：只用於小面積標記 -->
      <SolidColorBrush x:Key="FB.OverrideBrush" Color="#E8A43C" />
      <SolidColorBrush x:Key="FB.PresetUpdatedBrush" Color="#5AA9E6" />
      <SolidColorBrush x:Key="FB.ErrorBrush" Color="#E05555" />
      <SolidColorBrush x:Key="FB.SuccessBrush" Color="#6BBF59" />

      <!-- Tooltip 使用 FB 配色 -->
      <SolidColorBrush x:Key="ToolTipBackground" Color="#333333" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#444444" />

      <!-- Fluent 滑桿：軌道不分已填／未填（雙向參數以中央為零，不適合從左填色） -->
      <SolidColorBrush x:Key="SliderTrackFill" Color="#4A4A4A" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#5A5A5A" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#5A5A5A" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#4A4A4A" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#5A5A5A" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#5A5A5A" />

      <!-- ── Dock：面板之間以明度區分，分隔線隱形，拖曳時才以強調色提示 ── -->
      <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#232323" />
      <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#232323" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockSplitterHoverBrush" Color="#3D8EF0" />
      <SolidColorBrush x:Key="DockSplitterDragBrush" Color="#5AA0F3" />
      <SolidColorBrush x:Key="DockTargetIndicatorBrush" Color="#3D8EF0" />
      <!-- Dock 內部以 StaticResource 指向 DockThemeBorderLowBrush 的別名，需逐一覆寫才會生效 -->
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockBorderStrongBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#161616" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#232323" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#232323" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- 尺寸（計畫書 2.2.3）：基本字級 13px、以 4px 為基本單位；圓角放大讓介面較柔和 -->
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <x:Double x:Key="FB.ParamRowHeight">46</x:Double>
  <x:Double x:Key="FB.ParamSliderHeight">20</x:Double>
  <x:Double x:Key="FB.ModuleHeaderHeight">40</x:Double>
  <x:Boolean x:Key="FB.ModuleHeaderActionFocusable">False</x:Boolean>
  <x:Double x:Key="FB.FontSizeSmall">11</x:Double>
  <x:Double x:Key="FB.FontSizeTitle">14</x:Double>
  <sys:Double x:Key="DockCornerRadiusSmall">0</sys:Double>
  <!-- 工具面板頂端的 1px 分隔線：Dock 主題在 :pointerover 時會讓它出現，把面板內容往下推 1px，
       滑鼠移入／移出右側與底部面板時看起來會跳動。厚度設為 0，不論可見與否都不佔版面。 -->
  <sys:Double x:Key="DockToolChromeDividerThickness">0</sys:Double>
</ResourceDictionary>
