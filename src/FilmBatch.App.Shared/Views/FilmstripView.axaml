<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FilmBatch.App.ViewModels"
             xmlns:d="using:FilmBatch.App.ViewModels.Dialogs"
             xmlns:l="using:FilmBatch.App.Localization"
             x:Class="FilmBatch.App.Views.FilmstripView"
             x:DataType="vm:FilmstripViewModel">
  <!-- 縮圖列（計畫書 2.4.4）：水平虛擬化；Ctrl/⌘、Shift 多選；可拖放預設到縮圖上；在空白處按兩下選擇照片資料夾 -->
  <DockPanel Background="{DynamicResource FB.WindowBrush}">
    <Border DockPanel.Dock="Top" Padding="12,8,12,2">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
        <PathIcon Data="{StaticResource Icon.Filter}" Width="12" Height="12" Foreground="{DynamicResource FB.PlaceholderBrush}" VerticalAlignment="Center" />
        <ComboBox Classes="flat" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilterOption}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" MinWidth="120" />
        <ComboBox Classes="flat" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding FilterPreset}" MinWidth="140" PlaceholderText="{l:Tr Common.ChoosePreset}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetItemViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="color-label" Background="{Binding ColorBrush}" />
                <TextBlock Text="{Binding Name}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Classes="flat" ItemsSource="{Binding FileKindOptions}" SelectedItem="{Binding SelectedFileKindOption}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" MinWidth="110" />
        <ComboBox Name="RatingFilterCombo" Classes="flat" ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding SelectedRatingOption}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" MinWidth="100" />
        <TextBlock Classes="secondary small numeric" Text="{Binding CountText}" VerticalAlignment="Center" Margin="4,0" />
      </WrapPanel>
    </Border>
    <Panel>
    <ListBox Name="List" Classes="filmstrip" ItemsSource="{Binding Items}" Selection="{Binding Selection}"
             SelectionMode="Multiple" DragDrop.AllowDrop="True"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <ListBox.ContextMenu>
        <ContextMenu Name="PhotoMenu">
          <MenuItem Name="CopySettingsItem" Header="{l:Tr Cmd.Copy}" Command="{Binding Main.CopyCommand}" />
          <MenuItem Name="PasteSettingsItem" Header="{l:Tr Cmd.Paste}" Command="{Binding Main.PasteCommand}" />
          <MenuItem Header="{l:Tr Cmd.PastePresetOnly}" Command="{Binding Main.PastePresetOnlyCommand}" />
          <MenuItem Header="{l:Tr Cmd.PasteSpecial}" Command="{Binding Main.PasteSpecialCommand}" />
          <Separator />
          <!-- 評分：套用到所有選取照片（鍵盤 0 ~ 5 亦可） -->
          <MenuItem Name="RatingItem" Header="{l:Tr Cmd.Rating}">
            <MenuItem Header="★★★★★" Command="{Binding Main.SetRatingCommand}"><MenuItem.CommandParameter><x:Int32>5</x:Int32></MenuItem.CommandParameter></MenuItem>
            <MenuItem Header="★★★★" Command="{Binding Main.SetRatingCommand}"><MenuItem.CommandParameter><x:Int32>4</x:Int32></MenuItem.CommandParameter></MenuItem>
            <MenuItem Header="★★★" Command="{Binding Main.SetRatingCommand}"><MenuItem.CommandParameter><x:Int32>3</x:Int32></MenuItem.CommandParameter></MenuItem>
            <MenuItem Header="★★" Command="{Binding Main.SetRatingCommand}"><MenuItem.CommandParameter><x:Int32>2</x:Int32></MenuItem.CommandParameter></MenuItem>
            <MenuItem Header="★" Command="{Binding Main.SetRatingCommand}"><MenuItem.CommandParameter><x:Int32>1</x:Int32></MenuItem.CommandParameter></MenuItem>
            <Separator />
            <MenuItem Header="{l:Tr Cmd.ClearRating}" Command="{Binding Main.SetRatingCommand}"><MenuItem.CommandParameter><x:Int32>0</x:Int32></MenuItem.CommandParameter></MenuItem>
          </MenuItem>
          <Separator />
          <MenuItem Name="QuickExportItem" Header="{l:Tr Cmd.QuickExport}" Command="{Binding Main.QuickExportCommand}" />
          <Separator />
          <MenuItem Name="ResetPhotoItem" Header="{l:Tr Cmd.ResetSelected}" Command="{Binding Main.ResetPhotoCommand}" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ThumbnailViewModel">
          <Border Classes="thumb" ToolTip.Tip="{Binding FileName}" AutomationProperties.Name="{Binding FileName}">
            <Grid Width="128" Height="88">
              <Image Source="{Binding Bitmap}" Stretch="Uniform" />
              <TextBlock Classes="secondary small" Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{Binding Bitmap, Converter={x:Static ObjectConverters.IsNull}}" />
              <!-- 讀檔失敗：錯誤圖示，滑鼠停留看原因 -->
              <PathIcon Data="{StaticResource Icon.Warning}" Width="20" Height="20" Foreground="{DynamicResource FB.ErrorBrush}"
                        IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}" />
              <!-- 左下：色彩標籤 + 預設名稱縮寫 -->
              <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="5,1" CornerRadius="8" Background="#B0141414">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Classes="color-label" Width="6" Height="6" CornerRadius="3" Background="{Binding PresetBrush}" />
                  <TextBlock FontSize="10" Text="{Binding PresetLabel}" Foreground="#EAEAEA" />
                </StackPanel>
              </Border>
              <!-- 右下：星級評分（未評分不顯示） -->
              <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="5,1" CornerRadius="8" Background="#B0141414"
                      IsVisible="{Binding HasRating}">
                <TextBlock FontSize="10" Text="{Binding RatingStars}" Foreground="#EAEAEA" />
              </Border>
              <!-- 右上：● 有單張覆寫、⟳ 預設已更新 -->
              <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                <PathIcon Data="{StaticResource Icon.Sync}" Width="10" Height="10" Foreground="{DynamicResource FB.PresetUpdatedBrush}"
                          IsVisible="{Binding PresetUpdated}" ToolTip.Tip="{l:Tr Tip.PresetUpdated}" />
                <Ellipse Classes="override-dot" Width="8" Height="8" IsVisible="{Binding HasOverrides}" ToolTip.Tip="{l:Tr Tip.HasOverrides}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <!-- 尚未開啟資料夾時的提示（不攔截滑鼠，按兩下由 ListBox 處理） -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" IsVisible="{Binding !HasFolder}">
      <PathIcon Data="{StaticResource Icon.Open}" Width="16" Height="16" Foreground="{DynamicResource FB.PlaceholderBrush}" />
      <TextBlock Classes="secondary" Text="{l:Tr Filmstrip.OpenHint}" VerticalAlignment="Center" />
    </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
