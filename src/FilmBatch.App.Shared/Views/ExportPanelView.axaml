<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="using:FilmBatch.App.ViewModels.Dialogs"
             xmlns:l="using:FilmBatch.App.Localization"
             x:Class="FilmBatch.App.Views.ExportPanelView"
             x:DataType="d:ExportViewModel">
  <!-- 照片匯出分頁（計畫書 2.4.7、第 10 章）：欄位直向排列以配合側邊欄寬度 -->
  <DockPanel Background="{DynamicResource FB.PanelBrush}">
    <Border DockPanel.Dock="Top" Classes="panel-header">
      <TextBlock Classes="panel-title" Text="{l:Tr Panel.Export}" />
    </Border>

    <!-- 底部：摘要＋主要動作 -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource FB.DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Spacing="10">
        <Border Classes="summary-card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes="secondary small" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsVisible="{Binding IsExporting}" />
            <TextBlock Text="{Binding LastError}" TextWrapping="Wrap" Classes="warning small" IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
        <Button Classes="accent pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding StartExportCommand}" IsVisible="{Binding !IsExporting}" IsEnabled="{Binding CanExport}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource Icon.Export}" Width="14" Height="14" />
            <TextBlock Text="{l:Tr Dialog.Export}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="outline pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding CancelExportCommand}" IsVisible="{Binding IsExporting}">
          <TextBlock Text="{l:Tr Dialog.Cancel}" VerticalAlignment="Center" />
        </Button>
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,8,16,16" Spacing="18">
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.Scope}" />
          <ComboBox Classes="flat" HorizontalAlignment="Stretch" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" />
          <ComboBox Classes="flat" HorizontalAlignment="Stretch" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"
                    IsVisible="{Binding IsByPreset}" PlaceholderText="{l:Tr Common.ChoosePreset}" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.Format}" />
          <ComboBox Classes="flat" HorizontalAlignment="Stretch" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsJpeg}">
            <TextBlock Classes="param-name" Text="{l:Tr Export.Field.Quality}" />
            <NumericUpDown Grid.Column="1" Value="{Binding Quality}" Minimum="1" Maximum="100" Width="72" />
          </Grid>
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.ColorSpace}" />
          <ComboBox Classes="flat" HorizontalAlignment="Stretch" ItemsSource="{Binding ColorSpaces}" SelectedItem="{Binding SelectedColorSpace}"
                    IsEnabled="{Binding IsColorSpaceAvailable}" AutomationProperties.AutomationId="Export.ColorSpace"
                    ToolTip.Tip="{l:Tr Export.ColorSpace.Note}" />
          <TextBlock Classes="secondary small" Text="{l:Tr Export.ColorSpace.Note}" TextWrapping="Wrap" IsVisible="{Binding IsColorSpaceAvailable}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.Size}" />
          <ComboBox Classes="flat" HorizontalAlignment="Stretch" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" DisplayMemberBinding="{Binding Label, x:DataType=d:OptionBase}" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLongEdge}">
            <TextBlock Classes="param-name" Text="{l:Tr Export.Field.LongEdge}" />
            <NumericUpDown Grid.Column="1" Value="{Binding LongEdge}" Minimum="100" Maximum="20000" Width="88" />
          </Grid>
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.Destination}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding Destination}" />
            <Button Grid.Column="1" Classes="outline" Margin="8,0,0,0" Content="…" Command="{Binding BrowseDestinationCommand}" ToolTip.Tip="{l:Tr Common.ChooseFolder}" />
          </Grid>
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.FileName}" />
          <TextBox Text="{Binding FileNameTemplate}" PlaceholderText="{}{name}_{preset}" />
          <TextBlock Classes="secondary small" Text="{l:Tr Export.FileNameHint}" TextWrapping="Wrap" />
          <CheckBox IsChecked="{Binding OverwriteExisting}" Content="{l:Tr Export.Overwrite}" AutomationProperties.AutomationId="Export.Overwrite" />
          <TextBlock Classes="secondary small" Text="{l:Tr Export.Overwrite.Note}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Classes="field">
          <TextBlock Classes="field-label" Text="{l:Tr Export.Field.Metadata}" />
          <TextBlock Classes="secondary small" Text="{l:Tr Export.MetadataNote}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
