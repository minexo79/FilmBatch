<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FilmBatch.App.ViewModels"
             xmlns:l="using:FilmBatch.App.Localization"
             x:Class="FilmBatch.App.Controls.FilmLookControl"
             x:DataType="vm:FilmLookViewModel">
  <!-- 底片顏色模擬：底片分組下拉、.cube 色彩空間、縮圖格（docs/film-looks.md）。
       色彩空間只套在 .cube；Hald PNG 維持 sRGB。縮圖以焦點照片算出，只在 film 模組展開時算。 -->
  <UserControl.DataTemplates>
    <!-- 縮圖格內容：96×64 縮圖＋來源名稱；ProPhoto 匯入另標工作色彩空間 -->
    <DataTemplate DataType="vm:FilmTileViewModel">
      <StackPanel Spacing="2">
        <Border Classes="film-thumb" Height="64">
          <Panel>
            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
            <ProgressBar Classes="film-thumb-busy" IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Bottom" />
          </Panel>
        </Border>
        <TextBlock Classes="small" Text="{Binding Name}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                   IsVisible="{Binding HasDetail}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <StackPanel Spacing="6" Margin="0,4,0,4">
    <Grid ColumnDefinitions="*,Auto" Classes="param-line">
      <TextBlock Classes="param-name" Text="{l:Tr Film.Look}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" Classes="flat" MinWidth="150" VerticalAlignment="Center"
                ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroupItem}"
                DisplayMemberBinding="{Binding Label, x:DataType=vm:FilmGroupViewModel}"
                AutomationProperties.Name="{l:Tr Film.Look}" />
    </Grid>
    <Grid ColumnDefinitions="Auto,*">
      <Button Classes="flat" VerticalAlignment="Center"
              Content="{l:Tr Film.Import}"
              Command="{Binding ImportLutCommand}"
              AutomationProperties.Name="{l:Tr Film.Import}" />
      <ComboBox Grid.Column="1" Classes="flat" MinWidth="150" Margin="8,0,0,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                ItemsSource="{Binding ImportSpaces}" SelectedItem="{Binding ImportColorSpace}"
                DisplayMemberBinding="{Binding Label, x:DataType=vm:LutImportSpaceViewModel}"
                AutomationProperties.Name="{l:Tr Film.LutSpace}" />
    </Grid>
    <TextBlock Classes="secondary small" Text="{l:Tr Film.LutSpaceHint}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Imported}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FilmTileViewModel">
          <Button Classes="film-tile" Classes.selected="{Binding IsSelected}"
                  Command="{Binding $parent[ItemsControl].((vm:FilmLookViewModel)DataContext).ApplyLookCommand}"
                  CommandParameter="{Binding}" Content="{Binding}" ToolTip.Tip="{Binding AccessibleName}"
                  AutomationProperties.Name="{Binding AccessibleName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding Looks}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FilmTileViewModel">
          <Button Classes="film-tile" Classes.selected="{Binding IsSelected}"
                  Command="{Binding $parent[ItemsControl].((vm:FilmLookViewModel)DataContext).ApplyLookCommand}"
                  CommandParameter="{Binding}" Content="{Binding}" ToolTip.Tip="{Binding AccessibleName}"
                  AutomationProperties.Name="{Binding AccessibleName}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
